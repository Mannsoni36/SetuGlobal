---
interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  title?: string;
  links: LinkItem[];
}

const { title = "Related Guides", links } = Astro.props;
---

<section class="pb-4">
  <div class="container">
    <div class="border-border-light mx-auto max-w-3xl border-t pt-8">
      <p
        class="text-text-default/40 mb-4 text-xs font-bold tracking-widest uppercase">
        {title}
      </p>
      <div class="flex flex-wrap gap-3">
        {
          links.map((link) => (
            <a
              href={link.url}
              class="border-primary/20 bg-primary/5 text-primary hover:bg-primary rounded-full border px-4 py-2 text-xs font-semibold transition-colors hover:text-white">
              {link.label} →
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
