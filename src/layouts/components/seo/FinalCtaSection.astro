---
const whatsappUrl =
  "https://wa.me/918140881823?text=Hi%20Setu%20Global%20Solution%2C%20I%20want%20free%20guidance%20for%20Germany.";
---

<section class="bg-primary py-16 lg:py-20">
  <div class="container text-center" data-aos="fade-up" data-aos-duration="500">
    <h2 class="mb-2 text-2xl font-black text-white lg:text-3xl">
      Planning your Germany journey?
    </h2>
    <p class="mx-auto mb-1 max-w-md text-sm text-white/70">
      Book your free 1:1 consultation with Setu Global Solution.
    </p>
    <p class="mx-auto mb-7 max-w-md text-sm text-white/70">
      WhatsApp: +91 8140 881823
    </p>
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a
        href="/#contact"
        class="bg-secondary inline-block rounded-xl px-7 py-3.5 text-sm font-bold text-white transition-opacity hover:opacity-90">
        Book Free Consultation
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-xl border-2 border-white/30 px-7 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10">
        💬 WhatsApp Us
      </a>
    </div>
  </div>
</section>
