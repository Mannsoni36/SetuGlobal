---
interface Props {
  text?: string;
}

const { text = "Not sure where to start? Talk to us — it's free." } =
  Astro.props;
const whatsappUrl =
  "https://wa.me/918140881823?text=Hi%20Setu%20Global%20Solution%2C%20I%20want%20free%20guidance%20for%20Germany.";
---

<section class="py-2">
  <div class="container">
    <div
      class="bg-secondary/10 mx-auto flex max-w-3xl flex-col items-center justify-between gap-4 rounded-2xl p-6 sm:flex-row"
      data-aos="fade-up"
      data-aos-duration="500">
      <p
        class="text-text-default text-center text-sm font-semibold sm:text-left">
        {text}
      </p>
      <div class="flex shrink-0 gap-3">
        <a
          href="/#contact"
          class="bg-secondary inline-block rounded-lg px-5 py-2.5 text-xs font-bold text-white transition-opacity hover:opacity-90">
          Book Free Call
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border-secondary text-secondary hover:bg-secondary inline-block rounded-lg border-2 px-5 py-2.5 text-xs font-bold transition-colors hover:text-white">
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
