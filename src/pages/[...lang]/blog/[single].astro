---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import config from ".astro/config.generated.json";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { getEntryRouteParam, supportedLanguages } from "@/lib/utils/i18nUtils";
import { render } from "astro:content";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const blogIndex = await getEntryCTM("blog", "-index", lang.languageCode);

      let posts = await getCollectionCTM("blog", lang.languageCode);

      if (blogIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return posts.map((post) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single: getEntryRouteParam(post),
        },
        props: {
          post,
          blogIndex,
        },
      }));
    }),
  );

  return paths.flat();
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedDate = post.data.date ? new Date(post.data.date) : undefined;
const formattedDate = publishedDate
  ? publishedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : undefined;
---

<Base {...post.data}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.metaTitle || post.data.title,
      "description": post.data.metaDescription || post.data.description,
      "datePublished": publishedDate?.toISOString(),
      "author": {
        "@type": "Person",
        "name": post.data.author || "Setu Global Solution",
      },
      "publisher": {
        "@type": "Organization",
        "name": "Setu Global Solution",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.setuglobalsolution.com/images/logo.png",
        },
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href,
      },
    })}
  />

  <PageHeader title={post.data.title} breadcrumbTitle={post.data.title} />

  <section>
    <div class="relative container">
      {
        (formattedDate || post.data.author) && (
          <p class="text-text-default/60 mb-8 text-sm">
            {formattedDate}
            {formattedDate && post.data.author && <span aria-hidden="true"> · </span>}
            {post.data.author}
          </p>
        )
      }
      <div class="prose-styles content has-video-modal">
        <Content components={{ img: OptimizedImage }} />
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
